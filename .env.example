BLOGGER_BLOG_URL=https://thepipettesolution.blogspot.com
# Optional. Leave empty to resolve the numeric blog ID from the URL.
BLOGGER_BLOG_ID=

# Download this OAuth desktop client JSON from Google Cloud Console.
BLOGGER_CLIENT_SECRET=client_secret.json
BLOGGER_TOKEN=token.json

BLOGGER_DEFAULT_LABELS=molecular cloning,virology,protocol planning,research update
DRAFT_DIR=drafts

# Optional. If unset, the agent uses a deterministic local writing template.
# Any OpenAI-compatible chat-completions endpoint can be used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Keep educational unless you have a reviewed, institution-approved publishing workflow.
SAFETY_MODE=educational
