BLOGGER_BLOG_URL=https://thepipettesolution.blogspot.com
# Optional. Leave empty to resolve the numeric blog ID from the URL.
BLOGGER_BLOG_ID=

# Download this OAuth desktop client JSON from Google Cloud Console.
# This is only needed for --upload. You can use --email instead.
BLOGGER_CLIENT_SECRET=client_secret.json
BLOGGER_TOKEN=token.json

# No-Google-Cloud option: Blogger Settings -> Email -> Post using email.
# Set Blogger to save emailed posts as drafts, then enter the private address here.
BLOGGER_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

BLOGGER_DEFAULT_LABELS=molecular cloning,virology,protocol planning,research update
DRAFT_DIR=drafts

# Optional. If unset, the agent uses a deterministic local writing template.
# Any OpenAI-compatible chat-completions endpoint can be used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional Gemini support. Get an API key from Google AI Studio if available to you.
# Use GEMINI_TEXT_MODEL for better human-style writing.
# Use GEMINI_IMAGE_MODEL only if your Gemini model supports image generation.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_COUNT=2

# Keep educational unless you have a reviewed, institution-approved publishing workflow.
SAFETY_MODE=educational
